Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\PictureSlideshowScreensaver]
"Interval"="10"
"FadeTime"="2500"
"PhotosPerFolder"="10"
"WriteStat"="1"
"WriteStatFolder"="D:\\PH\\LOG"
"DependOnBattery"="0"
"ImageFolder"="Z:\\PHOTO_FRAME_STORE\\*"
"ImageFolder1"="D:\\PHOTO_RESIZED\\*"
"PerformanceOptions"=dword:00000001
"YandexApiKey"="get_from_bitwarden"
"WeatherProvider"="open-meteo"
"WeatherPollingMinutes"="60"

