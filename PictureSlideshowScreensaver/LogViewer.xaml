<Window x:Class="PictureSlideshowScreensaver.LogViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log" Height="600" Width="950"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#FF1A1A1A"
        ResizeMode="CanResize">
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
  </Window.InputBindings>
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
      <TextBlock DockPanel.Dock="Left" Foreground="#AAAAAA" VerticalAlignment="Center"
                 Margin="0,0,8,0" Text="File:" />
      <Button DockPanel.Dock="Right" Content="Open folder" Padding="10,3" Margin="8,0,0,0"
              Command="{Binding OpenFolderCommand}" />
      <TextBox Text="{Binding LogPath, Mode=OneWay}" IsReadOnly="True"
               Background="Transparent" Foreground="#DDDDDD" BorderThickness="0"
               VerticalAlignment="Center" />
    </DockPanel>

    <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
             FontFamily="Consolas" FontSize="12"
             Background="#FF101010" Foreground="#EEEEEE" BorderBrush="#333" BorderThickness="1"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             TextWrapping="NoWrap"
             VerticalContentAlignment="Top" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <TextBlock Foreground="#888888" VerticalAlignment="Center" Margin="0,0,16,0"
                 Text="{Binding StatusText}" />
      <Button Content="Refresh (F5)" Padding="10,3" Margin="0,0,8,0" Command="{Binding RefreshCommand}" />
      <Button Content="Clear log" Padding="10,3" Margin="0,0,8,0" Command="{Binding ClearCommand}" />
      <Button Content="Close (Esc)" Padding="10,3" Command="{Binding CloseCommand}" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
