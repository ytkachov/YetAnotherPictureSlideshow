<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Yaps.Infrastructure</RootNamespace>
    <AssemblyName>Yaps.Infrastructure</AssemblyName>
    <!-- The Stage 4 image-bitmap loader produces frozen
         System.Windows.Media.Imaging.BitmapImage instances. PresentationCore
         and WindowsBase are the minimum WPF assemblies needed; UseWPF would
         also pull in PresentationFramework which we don't need here. -->
    <UseWpf>true</UseWpf>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YAPS.Core\YAPS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.Extensions" />
    <PackageReference Include="Selenium.Support" />
    <PackageReference Include="Selenium.WebDriver" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

</Project>
