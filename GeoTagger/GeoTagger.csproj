<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Bumped from net8.0 to net8.0-windows because GeoTagger now consumes
         YAPS.Infrastructure (Windows-targeted). Practically GeoTagger has
         always been a Windows-only tool, so this is a tightening, not a
         loss. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>GeoTagger</RootNamespace>
    <AssemblyName>GeoTagger</AssemblyName>
    <Nullable>disable</Nullable>
    <AssemblyTitle>GeoTagger</AssemblyTitle>
    <Description>Adds geo-location place names to .finfo files for photos with known GPS coordinates.</Description>
    <Product>GeoTagger</Product>
    <Copyright>Copyright © 2024</Copyright>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExifLibNet" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YAPS.Core\YAPS.Core.csproj" />
    <ProjectReference Include="..\YAPS.Infrastructure\YAPS.Infrastructure.csproj" />
  </ItemGroup>

</Project>
