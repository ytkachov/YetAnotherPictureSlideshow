<Window x:Class="PictureSlideshowScreensaver.StatsViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реестр показов" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#FF1A1A1A"
        ResizeMode="CanResize">
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
  </Window.InputBindings>
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
      <TextBlock DockPanel.Dock="Left" Foreground="#AAAAAA" VerticalAlignment="Center"
                 Margin="0,0,8,0" Text="Реестр:" />
      <Button DockPanel.Dock="Right" Content="Открыть папку" Padding="10,3" Margin="8,0,0,0"
              Command="{Binding OpenFolderCommand}" />
      <TextBox Text="{Binding StatsPath, Mode=OneWay}" IsReadOnly="True"
               Background="Transparent" Foreground="#DDDDDD" BorderThickness="0"
               VerticalAlignment="Center" />
    </DockPanel>

    <TextBox Grid.Row="1" Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True"
             FontFamily="Consolas" FontSize="12"
             Background="#FF101010" Foreground="#EEEEEE" BorderBrush="#333" BorderThickness="1"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             TextWrapping="NoWrap"
             VerticalContentAlignment="Top" />

    <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" Foreground="#888888" VerticalAlignment="Center"
                 Text="{Binding StatusText}" />
      <Button DockPanel.Dock="Right" Content="Закрыть (Esc)" Padding="10,3" Command="{Binding CloseCommand}" IsCancel="True" />
      <Button DockPanel.Dock="Right" Content="Сохранить в файл" Padding="10,3" Margin="0,0,8,0" Command="{Binding SaveCommand}" />
      <Button DockPanel.Dock="Right" Content="Обновить (F5)" Padding="10,3" Margin="0,0,8,0" Command="{Binding RefreshCommand}" />
    </DockPanel>
  </Grid>
</Window>
