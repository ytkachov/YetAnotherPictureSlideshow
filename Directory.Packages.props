<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosting / DI / Configuration -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />

    <!-- Logging -->
    <PackageVersion Include="Serilog" Version="4.3.0" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Serialization -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- Image / EXIF / OpenCV -->
    <PackageVersion Include="ExifLibNet" Version="2.1.4" />
    <PackageVersion Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageVersion Include="OpenCvSharp4.Extensions" Version="4.10.0.20240616" />
    <PackageVersion Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
    <PackageVersion Include="System.Drawing.Common" Version="8.0.10" />

    <!-- WPF helpers -->
    <PackageVersion Include="CalcBinding6" Version="1.1.0" />
    <PackageVersion Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122" />

    <!-- Selenium (Weather scrapers) -->
    <PackageVersion Include="Selenium.WebDriver" Version="4.22.0" />
    <PackageVersion Include="Selenium.Support" Version="4.22.0" />

    <!-- Windows Task Scheduler -->
    <PackageVersion Include="TaskScheduler" Version="2.10.1" />
  </ItemGroup>

</Project>
