<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>PictureSlideshowScreensaver</RootNamespace>
    <AssemblyName>PictureSlideshowScreensaver</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <StartupObject>PictureSlideshowScreensaver.App</StartupObject>
    <ApplicationIcon>preferences-desktop-screensaver.ico</ApplicationIcon>
    <NoWin32Manifest>true</NoWin32Manifest>
    <Platforms>AnyCPU;x86;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CalcBinding6" />
    <PackageReference Include="ExifLibNet" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.Extensions" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Weather\Weather.csproj" />
    <ProjectReference Include="..\YAPS.Core\YAPS.Core.csproj" />
    <ProjectReference Include="..\YAPS.Infrastructure\YAPS.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Haar cascade XMLs are loaded from disk by OpenCvFaceDetector
         (CascadeClassifier takes a file path). They must land in the
         output directory; <Resource> would embed them in the assembly
         as a resource stream instead, which is not what we want.
         PreserveNewest keeps incremental builds fast. -->
    <Content Include="recognition\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
