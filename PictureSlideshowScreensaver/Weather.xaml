<UserControl x:Class="presenters.Weather"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:CustomControls="clr-namespace:CustomControls"
             xmlns:informers="clr-namespace:informers"
             xmlns:presenters="clr-namespace:presenters"
             xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="300"
             >

  <!-- Stage 6.4: each column carries a SharedSizeGroup. With
       Grid.IsSharedSizeScope=True on a common ancestor (set on the
       WeatherForecast root grid) every tile's column N grows to the
       widest content across all tiles, replacing the old measurement
       timer that cycled a hidden W_Invisible through every period.
       Auto sizing with SharedSizeGroup ignores Collapsed children, so
       a missing-metric tile still aligns with its neighbours.

       Outer two-column Grid wraps the 5-column tile grid in col 0 and
       the provider-source badge in col 1 so the badge sits to the right
       of the H tile instead of overlaying it. The badge column is Auto
       width and Collapsed-friendly: when ShowSource=False the badge
       takes 0 width and the tile row sits flush against the parent.
       Only W_now in Screensaver.xaml sets ShowSource=True; forecast
       tiles inherit the default false to avoid 13 chips on the overlay. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0">
    <Grid.Resources>
      <Style TargetType="CustomControls:OutlinedTextBlock">
        <Setter Property="FontFamily" Value="{Binding FontFamily}" />
        <Setter Property="FontSize" Value="{Binding FontSize}" />
        <Setter Property="Fill" Value="{Binding FillColor}" />
        <Setter Property="Stroke" Value="{Binding StrokeColor}" />
        <Setter Property="VerticalAlignment" Value="Center"  />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="StrokeThickness" Value="2" />
      </Style>
      <Style TargetType="Border">
        <Setter Property="Padding" Value="{Binding ChildPadding}"  />
        <Setter Property="Margin" Value="{Binding ChildMargin}"  />
        <Setter Property="BorderThickness" Value="{Binding ChildBorderThickness}"  />
        <Setter Property="BorderBrush" Value="{Binding BorderColor}"  />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" SharedSizeGroup="WeatherCol_T" />
      <ColumnDefinition Width="Auto" SharedSizeGroup="WeatherCol_W" />
      <ColumnDefinition Width="Auto" SharedSizeGroup="WeatherCol_Wind" />
      <ColumnDefinition Width="Auto" SharedSizeGroup="WeatherCol_P" />
      <ColumnDefinition Width="Auto" SharedSizeGroup="WeatherCol_H" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" x:Name="T_Border" Visibility="{Binding Informer.Weather_Status_Temperature, Converter={informers:WeatherStatusToVisibility}}" >
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
        <CustomControls:OutlinedTextBlock x:Name="TR" Visibility="{Binding Show, Converter={presenters:ShowRange}}" Text="{Binding Informer.TemperatureRange}" />
        <CustomControls:OutlinedTextBlock x:Name="TV" Visibility="{Binding Show, Converter={presenters:ShowValue}}" Text="{Binding Informer.Temperature}" />
        <CustomControls:OutlinedTextBlock x:Name="T_Scale"  Text="°" />
      </StackPanel>
    </Border>
    <Border Grid.Column="1" x:Name="W_Border" Visibility="{Binding Informer.Weather_Status_Weather, Converter={informers:WeatherStatusToVisibility}}" >
      <Viewbox x:Name="W" VerticalAlignment="Center" HorizontalAlignment="Center" Width="{Binding PictureSize}" Stretch="Uniform">
        <ContentControl x:Name="W_content" Opacity="1.0">
          <ContentControl.Content>
            <MultiBinding Converter="{informers:WeatherToPicture}">
              <Binding Path="Informer.Weather"/>
              <Binding Path="Informer.Weather_Period"/>
            </MultiBinding>
          </ContentControl.Content>
        </ContentControl>
      </Viewbox>
    </Border>
    <Border Grid.Column="2" x:Name="WIND_Border" Visibility="{Binding Informer.Weather_Status_Wind, Converter={informers:WeatherStatusToVisibility}}" >
      <StackPanel Orientation="Horizontal">
        <Viewbox x:Name="WD" VerticalAlignment="Center" HorizontalAlignment="Center" Width="{c:Binding PictureSize * 0.75}" Stretch="Uniform">
          <ContentControl x:Name="WD_content" Content="{Binding Informer.WindDirection, Converter={informers:WindDirectionToPicture UseColor=yes}}"/>
        </Viewbox>
        <CustomControls:OutlinedTextBlock x:Name="WS"  Text="{Binding Informer.WindSpeed}" />
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
          </Grid.RowDefinitions>
          <CustomControls:OutlinedTextBlock Grid.Row="1" x:Name="WS_Scale"  Text="м/с" FontSize="{c:Binding FontSize * 0.6}" VerticalAlignment="Bottom" />
        </Grid>
      </StackPanel>
    </Border>
    <Border Grid.Column="3" x:Name="P_Border" Visibility="{Binding Informer.Weather_Status_Pressure, Converter={informers:WeatherStatusToVisibility}}" >
      <StackPanel Orientation="Horizontal">
        <CustomControls:OutlinedTextBlock x:Name="P"  Text="{Binding Informer.Pressure}" />
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
          </Grid.RowDefinitions>
          <CustomControls:OutlinedTextBlock Grid.Row="1" x:Name="P_Scale"  Text="mm" FontSize="{c:Binding FontSize * 0.6}" VerticalAlignment="Bottom" />
        </Grid>
      </StackPanel>
    </Border>
    <Border Grid.Column="4" x:Name="H_Border" Visibility="{Binding Informer.Weather_Status_Humidity, Converter={informers:WeatherStatusToVisibility}}" >
      <StackPanel Orientation="Horizontal">
        <CustomControls:OutlinedTextBlock x:Name="H"  Text="{Binding Informer.Humidity}" />
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
          </Grid.RowDefinitions>
          <CustomControls:OutlinedTextBlock Grid.Row="1" x:Name="H_Scale"  Text="%" FontSize="{c:Binding FontSize * 0.6}" VerticalAlignment="Bottom" />
        </Grid>
      </StackPanel>
    </Border>
    </Grid>
    <!-- Tier badge — lives in its own column to the right of the H tile.
         WeatherStatusToVisibility is reused for the bool→Visibility
         conversion (it tolerates UnsetValue when the parent DataContext
         hasn't pushed Informer yet). -->
    <CustomControls:OutlinedTextBlock Grid.Column="1" x:Name="SourceBadge"
        Text="{Binding Informer.SourceLabel}"
        Visibility="{Binding ShowSource, Converter={informers:WeatherStatusToVisibility}}"
        HorizontalAlignment="Left" VerticalAlignment="Top"
        FontFamily="{Binding FontFamily}"
        Fill="{Binding FillColor}" Stroke="{Binding StrokeColor}"
        StrokeThickness="1"
        FontSize="{c:Binding FontSize * 0.35}"
        Margin="4,2,0,0" />
  </Grid>
</UserControl>
