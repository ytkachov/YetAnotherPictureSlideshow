<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GeoTagger</RootNamespace>
    <AssemblyName>GeoTagger</AssemblyName>
    <Nullable>disable</Nullable>
    <AssemblyTitle>GeoTagger</AssemblyTitle>
    <Description>Adds geo-location place names to .finfo files for photos with known GPS coordinates.</Description>
    <Product>GeoTagger</Product>
    <Copyright>Copyright © 2024</Copyright>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExifLibNet" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PictureSlideshowScreensaver\Models\FinfoData.cs" Link="Models\FinfoData.cs" />
    <Compile Include="..\PictureSlideshowScreensaver\Services\GeocodingService.cs" Link="Services\GeocodingService.cs" />
  </ItemGroup>

</Project>
